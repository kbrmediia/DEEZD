<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SoulFlow Breathing | Awaken Your Inner Energy</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Raleway:wght@300;400;500;600&display=swap');

  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --gold: #c9a84c;
    --gold-light: #e8d08a;
    --deep-purple: #1a0a2e;
    --mid-purple: #2d1b5e;
    --soft-purple: #4a2f8a;
    --teal: #2a9d8f;
    --cream: #faf6f0;
    --text-dark: #1a1a2e;
    --text-mid: #4a4060;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Raleway', sans-serif;
    background: var(--cream);
    color: var(--text-dark);
    overflow-x: hidden;
  }

  /* ── NAV ──────────────────────────────────────── */
  nav {
    position: fixed; top: 0; width: 100%; z-index: 1000;
    padding: 1.2rem 4rem;
    display: flex; justify-content: space-between; align-items: center;
    background: rgba(26, 10, 46, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(201, 168, 76, 0.25);
    transition: all 0.4s;
  }
  .nav-logo {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem; font-weight: 300; letter-spacing: 0.12em;
    color: var(--gold-light);
  }
  .nav-logo span { color: var(--gold); font-style: italic; }
  .nav-links { display: flex; gap: 2.5rem; list-style: none; }
  .nav-links a {
    color: rgba(255,255,255,0.75); text-decoration: none;
    font-size: 0.78rem; letter-spacing: 0.18em; text-transform: uppercase;
    font-weight: 500; transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--gold-light); }
  .nav-cta {
    padding: 0.55rem 1.6rem;
    border: 1px solid var(--gold);
    color: var(--gold) !important;
    border-radius: 30px;
    transition: all 0.3s !important;
  }
  .nav-cta:hover { background: var(--gold); color: var(--deep-purple) !important; }

  /* ── HERO ─────────────────────────────────────── */
  #hero {
    min-height: 100vh;
    background: linear-gradient(135deg, #0d0620 0%, #1a0a2e 35%, #2d1b5e 70%, #1a3a4a 100%);
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }

  /* Animated orbs */
  .orb {
    position: absolute; border-radius: 50%;
    filter: blur(60px); opacity: 0.35;
    animation: floatOrb 12s ease-in-out infinite;
  }
  .orb-1 { width: 500px; height: 500px; background: radial-gradient(circle, #4a2f8a, transparent); top: -100px; left: -100px; animation-delay: 0s; }
  .orb-2 { width: 350px; height: 350px; background: radial-gradient(circle, #2a9d8f, transparent); bottom: 50px; right: -80px; animation-delay: 3s; }
  .orb-3 { width: 280px; height: 280px; background: radial-gradient(circle, #c9a84c, transparent); top: 40%; left: 60%; animation-delay: 6s; }

  @keyframes floatOrb {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-30px) scale(1.08); }
  }

  /* Star particles */
  .stars { position: absolute; inset: 0; }
  .star {
    position: absolute; width: 2px; height: 2px;
    background: white; border-radius: 50%;
    animation: twinkle 4s ease-in-out infinite;
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.2; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }

  /* Central mandala */
  .mandala-container {
    position: absolute; width: 600px; height: 600px;
    top: 50%; left: 50%; transform: translate(-50%, -50%);
    opacity: 0.12;
  }
  .mandala-container svg { width: 100%; height: 100%; animation: rotateMandala 60s linear infinite; }
  @keyframes rotateMandala { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  .hero-content {
    position: relative; z-index: 10;
    text-align: center; padding: 0 2rem;
    display: flex; flex-direction: column; align-items: center; gap: 2rem;
  }

  .hero-badge {
    font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--gold); border: 1px solid rgba(201,168,76,0.4);
    padding: 0.4rem 1.4rem; border-radius: 30px;
    background: rgba(201,168,76,0.08);
  }

  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(3.5rem, 8vw, 7rem);
    font-weight: 300; line-height: 1.08;
    color: white; letter-spacing: 0.02em;
  }
  .hero-title em { color: var(--gold-light); font-style: italic; display: block; }

  .breath-ring {
    width: 160px; height: 160px; position: relative;
    display: flex; align-items: center; justify-content: center;
  }
  .breath-ring::before, .breath-ring::after {
    content: ''; position: absolute; border-radius: 50%;
    border: 1px solid rgba(201,168,76,0.5);
  }
  .breath-ring::before { inset: 0; animation: breathe 5s ease-in-out infinite; }
  .breath-ring::after { inset: 20px; animation: breathe 5s ease-in-out infinite 0.5s; border-color: rgba(42,157,143,0.5); }
  .breath-inner {
    width: 80px; height: 80px; border-radius: 50%;
    background: radial-gradient(circle, rgba(201,168,76,0.6), rgba(74,47,138,0.4));
    animation: breathe 5s ease-in-out infinite 1s;
    display: flex; align-items: center; justify-content: center;
  }
  .breath-inner-dot { width: 12px; height: 12px; border-radius: 50%; background: var(--gold); }

  @keyframes breathe {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.2); opacity: 1; }
  }

  .hero-sub {
    font-size: 1.15rem; color: rgba(255,255,255,0.65);
    max-width: 560px; line-height: 1.8; font-weight: 300; letter-spacing: 0.03em;
  }

  .hero-actions { display: flex; gap: 1.2rem; flex-wrap: wrap; justify-content: center; }
  .btn-primary {
    padding: 1rem 2.4rem; background: linear-gradient(135deg, var(--gold), #a07830);
    color: white; border: none; border-radius: 40px; font-family: 'Raleway', sans-serif;
    font-size: 0.82rem; letter-spacing: 0.2em; text-transform: uppercase;
    font-weight: 600; cursor: pointer; text-decoration: none;
    transition: all 0.3s; box-shadow: 0 8px 30px rgba(201,168,76,0.35);
  }
  .btn-primary:hover { transform: translateY(-3px); box-shadow: 0 14px 40px rgba(201,168,76,0.5); }
  .btn-ghost {
    padding: 1rem 2.4rem; background: transparent;
    color: rgba(255,255,255,0.8); border: 1px solid rgba(255,255,255,0.25);
    border-radius: 40px; font-family: 'Raleway', sans-serif;
    font-size: 0.82rem; letter-spacing: 0.2em; text-transform: uppercase;
    font-weight: 500; cursor: pointer; text-decoration: none; transition: all 0.3s;
  }
  .btn-ghost:hover { border-color: var(--gold-light); color: var(--gold-light); transform: translateY(-3px); }

  .scroll-hint {
    margin-top: 1rem; color: rgba(255,255,255,0.35);
    font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase;
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
  }
  .scroll-arrow {
    width: 1px; height: 40px; background: linear-gradient(to bottom, transparent, rgba(201,168,76,0.6));
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse { 0%, 100% { opacity: 0; transform: scaleY(0.5) translateY(-10px); } 50% { opacity: 1; transform: scaleY(1) translateY(0); } }

  /* ── SECTION BASE ─────────────────────────────── */
  section { padding: 7rem 4rem; }
  .section-label {
    font-size: 0.72rem; letter-spacing: 0.35em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 1rem; display: block;
  }
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    font-weight: 300; line-height: 1.2; color: var(--text-dark);
  }
  .section-title em { color: var(--soft-purple); font-style: italic; }
  .section-title.light { color: white; }
  .section-title.light em { color: var(--gold-light); }
  .divider {
    width: 60px; height: 1px;
    background: linear-gradient(to right, var(--gold), transparent);
    margin: 1.5rem 0 2.5rem;
  }
  .divider.center { margin: 1.5rem auto 2.5rem; }

  /* ── ABOUT ────────────────────────────────────── */
  #about {
    background: var(--cream);
    display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: center;
    max-width: 1300px; margin: 0 auto;
  }
  #about-wrapper { background: var(--cream); }

  .about-visual {
    position: relative; display: flex; align-items: center; justify-content: center;
    min-height: 500px;
  }

  /* SVG lotus illustration */
  .lotus-wrap { position: relative; width: 380px; height: 380px; }
  .lotus-bg {
    position: absolute; inset: 0; border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, rgba(74,47,138,0.08), rgba(42,157,143,0.05));
    border: 1px solid rgba(201,168,76,0.15);
    animation: breathe 7s ease-in-out infinite;
  }
  .lotus-outer-ring {
    position: absolute; inset: -20px; border-radius: 50%;
    border: 1px dashed rgba(201,168,76,0.2);
    animation: rotateMandala 30s linear infinite reverse;
  }
  .about-text p {
    color: var(--text-mid); line-height: 1.9; font-size: 1.05rem;
    margin-bottom: 1.4rem; font-weight: 300;
  }
  .about-text strong { color: var(--text-dark); font-weight: 500; }

  .energy-stats {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 2.5rem;
  }
  .stat-card {
    padding: 1.4rem 1.6rem;
    border: 1px solid rgba(201,168,76,0.2);
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(74,47,138,0.04), rgba(42,157,143,0.03));
  }
  .stat-number {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2.4rem; color: var(--gold); font-weight: 300;
  }
  .stat-label { font-size: 0.78rem; color: var(--text-mid); letter-spacing: 0.1em; margin-top: 0.2rem; }

  /* ── METHOD ───────────────────────────────────── */
  #method-wrapper {
    background: linear-gradient(160deg, var(--deep-purple) 0%, var(--mid-purple) 60%, #1a3a4a 100%);
    position: relative; overflow: hidden;
  }
  #method-wrapper::before {
    content: ''; position: absolute; inset: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.02'%3E%3Ccircle cx='30' cy='30' r='1'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }
  #method { max-width: 1300px; margin: 0 auto; position: relative; z-index: 1; }
  .method-intro { text-align: center; max-width: 650px; margin: 0 auto 5rem; }
  .method-intro p { color: rgba(255,255,255,0.6); line-height: 1.8; font-size: 1.05rem; font-weight: 300; margin-top: 1rem; }

  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .pillar {
    padding: 2.5rem 2rem;
    border: 1px solid rgba(201,168,76,0.15);
    border-radius: 16px;
    background: rgba(255,255,255,0.04);
    backdrop-filter: blur(10px);
    text-align: center;
    transition: all 0.4s;
    position: relative; overflow: hidden;
  }
  .pillar::before {
    content: ''; position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    width: 60%; height: 1px;
    background: linear-gradient(to right, transparent, var(--gold), transparent);
  }
  .pillar:hover { transform: translateY(-8px); border-color: rgba(201,168,76,0.4); background: rgba(255,255,255,0.07); }

  .pillar-icon { margin: 0 auto 1.8rem; width: 80px; height: 80px; }
  .pillar h3 {
    font-family: 'Cormorant Garamond', serif; font-size: 1.6rem; font-weight: 400;
    color: var(--gold-light); margin-bottom: 1rem;
  }
  .pillar p { color: rgba(255,255,255,0.55); line-height: 1.8; font-size: 0.95rem; font-weight: 300; }
  .pillar-num {
    font-family: 'Cormorant Garamond', serif; font-size: 4rem; font-weight: 300;
    color: rgba(201,168,76,0.1); position: absolute; top: 0.8rem; right: 1.2rem;
    line-height: 1;
  }

  /* ── BENEFITS ─────────────────────────────────── */
  #benefits-wrapper { background: var(--cream); }
  #benefits { max-width: 1300px; margin: 0 auto; }
  .benefits-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 0;
    margin-top: 4rem;
  }
  .benefit-item {
    padding: 2.5rem 3rem;
    border-bottom: 1px solid rgba(74,47,138,0.1);
    border-right: 1px solid rgba(74,47,138,0.1);
    display: flex; gap: 1.5rem; align-items: flex-start;
    transition: background 0.3s;
  }
  .benefit-item:nth-child(even) { border-right: none; }
  .benefit-item:nth-last-child(-n+2) { border-bottom: none; }
  .benefit-item:hover { background: rgba(74,47,138,0.04); }

  .benefit-icon {
    width: 48px; height: 48px; flex-shrink: 0;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(74,47,138,0.12), rgba(42,157,143,0.08));
    display: flex; align-items: center; justify-content: center;
    border: 1px solid rgba(201,168,76,0.2);
  }
  .benefit-text h4 {
    font-family: 'Cormorant Garamond', serif; font-size: 1.25rem; font-weight: 400;
    color: var(--text-dark); margin-bottom: 0.5rem;
  }
  .benefit-text p { color: var(--text-mid); font-size: 0.92rem; line-height: 1.7; font-weight: 300; }

  /* ── CLASSES ──────────────────────────────────── */
  #classes-wrapper {
    background: linear-gradient(180deg, #f5f0ff 0%, var(--cream) 100%);
  }
  #classes { max-width: 1300px; margin: 0 auto; }
  .classes-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: end; margin-bottom: 4rem; }
  .classes-intro p { color: var(--text-mid); line-height: 1.8; font-weight: 300; }

  .class-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .class-card {
    border-radius: 20px; overflow: hidden;
    box-shadow: 0 4px 30px rgba(74,47,138,0.08);
    transition: all 0.4s; background: white;
    display: flex; flex-direction: column;
  }
  .class-card:hover { transform: translateY(-10px); box-shadow: 0 20px 50px rgba(74,47,138,0.15); }

  .card-visual {
    height: 200px; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
  }
  .card-visual.v1 { background: linear-gradient(135deg, #1a0a2e, #4a2f8a); }
  .card-visual.v2 { background: linear-gradient(135deg, #0a2e2a, #2a9d8f); }
  .card-visual.v3 { background: linear-gradient(135deg, #2e1a0a, #8a6f2f); }

  .card-badge {
    position: absolute; top: 1rem; right: 1rem;
    font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;
    background: rgba(255,255,255,0.15); color: white;
    padding: 0.3rem 0.8rem; border-radius: 20px;
    border: 1px solid rgba(255,255,255,0.2);
    backdrop-filter: blur(6px);
  }

  .card-body { padding: 2rem; flex: 1; display: flex; flex-direction: column; }
  .card-body h3 {
    font-family: 'Cormorant Garamond', serif; font-size: 1.5rem; font-weight: 400;
    color: var(--text-dark); margin-bottom: 0.8rem;
  }
  .card-body p { color: var(--text-mid); font-size: 0.92rem; line-height: 1.7; font-weight: 300; flex: 1; }
  .card-meta {
    margin-top: 1.5rem; padding-top: 1.2rem;
    border-top: 1px solid rgba(74,47,138,0.08);
    display: flex; justify-content: space-between; align-items: center;
  }
  .card-price {
    font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; color: var(--soft-purple);
  }
  .card-price span { font-size: 0.75rem; color: var(--text-mid); font-family: 'Raleway', sans-serif; }
  .card-link {
    font-size: 0.76rem; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--gold); text-decoration: none; font-weight: 600;
    display: flex; align-items: center; gap: 0.4rem; transition: gap 0.3s;
  }
  .card-link:hover { gap: 0.8rem; }

  /* ── TESTIMONIALS ─────────────────────────────── */
  #testimonials-wrapper {
    background: linear-gradient(160deg, #0f0820 0%, #1a0a2e 100%);
    position: relative; overflow: hidden;
  }
  #testimonials { max-width: 1300px; margin: 0 auto; position: relative; z-index: 1; }
  .testimonials-header { text-align: center; margin-bottom: 4rem; }

  .testi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .testi-card {
    padding: 2.2rem; border-radius: 16px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(201,168,76,0.12);
    backdrop-filter: blur(10px);
    transition: all 0.3s;
  }
  .testi-card:hover { border-color: rgba(201,168,76,0.3); background: rgba(255,255,255,0.07); }
  .stars-row { display: flex; gap: 0.25rem; margin-bottom: 1.2rem; }
  .star-icon { color: var(--gold); font-size: 0.9rem; }
  .testi-quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.08rem; color: rgba(255,255,255,0.8);
    line-height: 1.8; font-style: italic; margin-bottom: 1.5rem;
  }
  .testi-author { display: flex; align-items: center; gap: 1rem; }
  .testi-avatar {
    width: 44px; height: 44px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Cormorant Garamond', serif; font-size: 1.1rem;
    color: white; font-weight: 300;
  }
  .av1 { background: linear-gradient(135deg, #4a2f8a, #2a9d8f); }
  .av2 { background: linear-gradient(135deg, #8a6f2f, #4a2f8a); }
  .av3 { background: linear-gradient(135deg, #2a9d8f, #1a0a2e); }
  .testi-name { color: rgba(255,255,255,0.7); font-size: 0.88rem; letter-spacing: 0.05em; }
  .testi-role { color: rgba(255,255,255,0.35); font-size: 0.78rem; margin-top: 0.1rem; }

  /* ── INSTRUCTOR ───────────────────────────────── */
  #instructor-wrapper { background: var(--cream); }
  #instructor {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1.4fr; gap: 6rem; align-items: center;
  }
  .instructor-visual {
    position: relative; display: flex; justify-content: center;
  }
  .instructor-frame {
    width: 320px; height: 400px; border-radius: 200px 200px 120px 120px;
    background: linear-gradient(160deg, #4a2f8a, #1a0a2e);
    display: flex; align-items: center; justify-content: center;
    position: relative; overflow: hidden;
  }
  .instructor-frame::after {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 40% 30%, rgba(201,168,76,0.15), transparent 60%);
  }
  .instructor-silhouette { position: relative; z-index: 1; }
  .instructor-glow {
    position: absolute; inset: -30px;
    border-radius: 50%; opacity: 0.2;
    background: radial-gradient(circle, var(--gold), transparent 70%);
    animation: breathe 6s ease-in-out infinite;
  }

  .instructor-text .section-title { margin-bottom: 0.5rem; }
  .instructor-title {
    font-size: 0.82rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 1.5rem;
  }
  .instructor-bio { color: var(--text-mid); line-height: 1.9; font-size: 1rem; font-weight: 300; margin-bottom: 1rem; }
  .credentials { margin-top: 2rem; display: flex; flex-direction: column; gap: 0.8rem; }
  .cred { display: flex; align-items: center; gap: 1rem; }
  .cred-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: linear-gradient(135deg, var(--gold), var(--teal)); flex-shrink: 0;
  }
  .cred span { font-size: 0.92rem; color: var(--text-mid); font-weight: 300; }

  /* ── CTA ──────────────────────────────────────── */
  #cta-wrapper {
    background: linear-gradient(135deg, #c9a84c 0%, #8a6f2f 40%, #4a2f8a 100%);
    position: relative; overflow: hidden;
  }
  #cta-wrapper::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(ellipse at 30% 50%, rgba(255,255,255,0.1), transparent 60%);
  }
  #cta {
    max-width: 800px; margin: 0 auto; text-align: center; position: relative; z-index: 1;
  }
  #cta .section-title { color: white; }
  #cta .section-title em { color: rgba(255,255,255,0.75); }
  #cta p { color: rgba(255,255,255,0.75); font-size: 1.1rem; line-height: 1.8; font-weight: 300; margin-top: 1.5rem; max-width: 540px; margin-left: auto; margin-right: auto; }
  .cta-actions { display: flex; gap: 1.2rem; justify-content: center; margin-top: 3rem; flex-wrap: wrap; }
  .btn-white {
    padding: 1.1rem 2.8rem;
    background: white; color: var(--soft-purple);
    border: none; border-radius: 40px;
    font-family: 'Raleway', sans-serif; font-size: 0.85rem;
    letter-spacing: 0.2em; text-transform: uppercase; font-weight: 600;
    cursor: pointer; text-decoration: none; transition: all 0.3s;
    box-shadow: 0 8px 30px rgba(0,0,0,0.2);
  }
  .btn-white:hover { transform: translateY(-3px); box-shadow: 0 14px 40px rgba(0,0,0,0.3); }
  .btn-outline-white {
    padding: 1.1rem 2.8rem;
