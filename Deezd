<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#0b0f17">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="My Lifts">
<link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230b0f17'/%3E%3Ctext x='50' y='68' font-size='56' text-anchor='middle'%3E%F0%9F%8F%8B%EF%B8%8F%3C/text%3E%3C/svg%3E">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext x='50' y='78' font-size='72' text-anchor='middle'%3E%F0%9F%8F%8B%EF%B8%8F%3C/text%3E%3C/svg%3E">
<title>My Lifts</title>
<style>
  :root{
    --bg:#0b0f17; --card:#151b27; --card2:#1b2330; --line:#26303f;
    --text:#e8edf5; --muted:#8b97a8; --accent:#5b8cff;
    --up:#34d399; --stay:#60a5fa; --down:#f59e0b; --done:#22c55e; --danger:#ef4444;
    --mbase:#2b3445; --nbase:#1b2230;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0; padding:0; min-height:100%;}
  body{
    background:var(--bg); color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    padding-bottom:calc(env(safe-area-inset-bottom) + 70px);
    overscroll-behavior-y:contain;
  }
  header{position:sticky; top:0; z-index:20; background:rgba(11,15,23,.92); backdrop-filter:blur(10px); border-bottom:1px solid var(--line); padding:calc(env(safe-area-inset-top) + 12px) 14px 0;}
  .titlebar{display:flex; align-items:center; justify-content:space-between; gap:8px;}
  .titlebar h1{font-size:20px; margin:0; letter-spacing:.3px;}
  .titlebar h1 small{color:var(--muted); font-weight:500; font-size:12px;}
  .iconbtn{background:var(--card2); border:1px solid var(--line); color:var(--text); width:40px; height:40px; border-radius:11px; font-size:17px; cursor:pointer; display:flex; align-items:center; justify-content:center;}
  .iconbtn.active{background:var(--accent); border-color:var(--accent); color:#fff;}
  .tabs{display:flex; gap:8px; overflow-x:auto; padding:12px 0 12px; scrollbar-width:none;}
  .tabs::-webkit-scrollbar{display:none;}
  .tab{flex:0 0 auto; padding:9px 15px; border-radius:999px; border:1px solid var(--line); background:var(--card); color:var(--muted); font-size:14px; font-weight:600; cursor:pointer; white-space:nowrap;}
  .tab.active{background:var(--accent); border-color:var(--accent); color:#fff;}
  .tab .dot{display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--done); margin-left:6px; vertical-align:middle;}

  main, section.view{padding:14px 12px 30px; max-width:680px; margin:0 auto;}
  .startbtn{width:100%; padding:17px; border-radius:16px; border:none; cursor:pointer; background:linear-gradient(135deg,var(--accent),#7c5cff); color:#fff; font-size:18px; font-weight:800; letter-spacing:.3px; margin-bottom:14px; box-shadow:0 10px 24px rgba(91,140,255,.32);}
  .startbtn .s{display:block; font-size:12px; font-weight:600; opacity:.85; margin-top:2px;}
  .daymeta{display:flex; align-items:center; justify-content:space-between; margin:2px 2px 8px; gap:10px;}
  .daymeta .prog{font-size:13px; color:var(--muted);}
  .daymeta .prog b{color:var(--text);}
  .smallbtn{background:var(--card2); border:1px solid var(--line); color:var(--text); padding:7px 11px; border-radius:10px; font-size:12.5px; font-weight:600; cursor:pointer;}
  .progbar{height:6px; background:var(--card2); border-radius:999px; overflow:hidden; margin:0 2px 14px;}
  .progbar > i{display:block; height:100%; background:linear-gradient(90deg,var(--accent),var(--done)); width:0; transition:width .3s;}

  .card{background:var(--card); border:1px solid var(--line); border-radius:14px; padding:12px; margin-bottom:10px; transition:opacity .2s, background .2s;}
  .card.done{background:#11261a; border-color:#1d533a;}
  .row{display:flex; align-items:flex-start; gap:12px;}
  .check{flex:0 0 auto; width:30px; height:30px; border-radius:9px; border:2px solid var(--line); background:var(--card2); cursor:pointer; display:flex; align-items:center; justify-content:center; margin-top:2px; font-size:18px; color:transparent; transition:all .15s;}
  .card.done .check{background:var(--done); border-color:var(--done); color:#06210f;}
  .info{flex:1 1 auto; min-width:0;}
  .name{font-size:16px; font-weight:650; line-height:1.25; word-wrap:break-word;}
  .card.done .name{color:#bde7cf;}
  .note{font-size:12.5px; color:var(--muted); margin-top:3px; line-height:1.3;}
  .meta{display:flex; align-items:center; gap:8px; margin-top:9px; flex-wrap:wrap;}
  .weight{background:var(--card2); border:1px solid var(--line); border-radius:9px; padding:6px 11px; font-size:15px; font-weight:700; cursor:pointer; color:var(--text); min-width:54px; text-align:center;}
  .weight.empty{color:var(--muted); font-weight:600; font-style:italic; font-size:13px;}
  .wedit{background:var(--card2); border:1px solid var(--accent); border-radius:9px; padding:6px 8px; font-size:15px; font-weight:700; color:var(--text); width:120px; outline:none;}
  .chip{font-size:11px; font-weight:800; letter-spacing:.4px; padding:4px 9px; border-radius:999px; text-transform:uppercase;}
  .chip.stay{background:rgba(96,165,250,.15); color:var(--stay); border:1px solid rgba(96,165,250,.35);}
  .chip.up{background:rgba(52,211,153,.15); color:var(--up); border:1px solid rgba(52,211,153,.4);}
  .chip.none{background:var(--card2); color:var(--muted); border:1px solid var(--line);}
  .delx{flex:0 0 auto; width:30px; height:30px; border-radius:8px; border:1px solid rgba(239,68,68,.4); background:rgba(239,68,68,.12); color:var(--danger); font-size:16px; cursor:pointer; margin-top:2px; display:flex; align-items:center; justify-content:center;}
  .editmode .nameinput{width:100%; background:var(--card2); border:1px solid var(--accent); border-radius:8px; color:var(--text); font-size:16px; font-weight:650; padding:6px 8px; outline:none;}
  .addbtn{width:100%; padding:13px; border-radius:12px; border:1px dashed var(--line); background:transparent; color:var(--muted); font-size:14px; font-weight:600; cursor:pointer;}
  .hint{font-size:12px; color:var(--muted); text-align:center; margin:18px 6px 4px; line-height:1.5;}

  /* ---------- Muscle view ---------- */
  .mhead{font-size:15px; color:var(--muted); margin:0 2px 12px; font-weight:600;}
  .mhead b{color:var(--text);}
  .figs{display:flex; gap:8px; justify-content:center; align-items:flex-start;}
  .figwrap{flex:1 1 0; min-width:0; background:linear-gradient(180deg,var(--card),#10151f); border:1px solid var(--line); border-radius:18px; padding:8px 4px 10px; text-align:center;}
  .figlabel{font-size:12px; font-weight:800; letter-spacing:1px; text-transform:uppercase; color:var(--muted); margin-bottom:2px;}
  .bodysvg{width:100%; height:auto; max-height:54vh; display:block; filter:drop-shadow(0 6px 12px rgba(0,0,0,.45));}
  .mz{fill:var(--mbase); stroke:#0c111b; stroke-width:1.5; stroke-linejoin:miter; transition:fill .35s ease;}
  .nz{fill:var(--nbase); stroke:#0c111b; stroke-width:1.3; stroke-linejoin:miter;}
  .ln{fill:none; stroke:rgba(5,8,13,.6); stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round;}
  .legend{display:flex; justify-content:center; gap:16px; margin:14px 0 6px; font-size:12.5px; color:var(--muted); font-weight:600;}
  .legend span{display:inline-flex; align-items:center; gap:6px;}
  .legend i{width:11px; height:11px; border-radius:50%; display:inline-block;}
  .msum{text-align:center; font-size:13px; color:var(--muted); margin:8px 0 12px;}
  .mrow{display:flex; align-items:center; gap:10px; background:var(--card); border:1px solid var(--line); border-radius:11px; padding:11px 13px; margin-bottom:7px;}
  .mdot{width:12px; height:12px; border-radius:50%; flex:0 0 auto;}
  .mname{flex:1; font-size:15px; font-weight:650;}
  .mcount{font-size:13px; font-weight:800; color:var(--muted);}

  /* ---------- Bottom nav ---------- */
  .bottomnav{position:fixed; left:0; right:0; bottom:0; z-index:40; display:flex; background:rgba(13,18,28,.96); backdrop-filter:blur(12px); border-top:1px solid var(--line); padding-bottom:env(safe-area-inset-bottom);}
  .navbtn{flex:1; background:none; border:none; color:var(--muted); padding:9px 0 10px; font-size:11px; font-weight:700; cursor:pointer; display:flex; flex-direction:column; align-items:center; gap:3px;}
  .navbtn .ni{font-size:22px; line-height:1; filter:grayscale(.4) opacity(.7);}
  .navbtn.active{color:var(--accent);}
  .navbtn.active .ni{filter:none;}

  /* ---------- Session ---------- */
  .session{position:fixed; inset:0; z-index:60; background:radial-gradient(120% 80% at 50% 0%, #131b2b 0%, #0b0f17 60%); display:flex; flex-direction:column; transform:translateY(100%); transition:transform .32s cubic-bezier(.2,.8,.2,1);}
  .session.open{transform:none;}
  .sess-top{display:flex; align-items:center; gap:12px; padding:calc(env(safe-area-inset-top) + 14px) 16px 10px;}
  .sess-top .x{width:38px; height:38px; flex:0 0 auto; border-radius:11px; background:var(--card2); border:1px solid var(--line); color:var(--text); font-size:18px; cursor:pointer;}
  .sbar{flex:1; height:8px; background:rgba(255,255,255,.08); border-radius:999px; overflow:hidden;}
  .sbar > i{display:block; height:100%; width:0; background:linear-gradient(90deg,var(--accent),var(--done)); transition:width .35s;}
  .sess-count{font-size:13px; font-weight:700; color:var(--muted); min-width:46px; text-align:right;}
  .stage{flex:1; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; padding:8px 16px;}
  .exCard{width:100%; max-width:560px; background:linear-gradient(180deg,var(--card) 0%, #121826 100%); border:1px solid var(--line); border-radius:24px; padding:26px 22px 22px; box-shadow:0 24px 60px rgba(0,0,0,.5); touch-action:pan-y; will-change:transform; display:flex; flex-direction:column; min-height:62vh;}
  .exCard .kicker{font-size:13px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase; color:var(--accent);}
  .exCard .exname{font-size:30px; font-weight:850; line-height:1.12; margin:12px 0 4px; word-wrap:break-word;}
  .exCard .exnote{font-size:15px; color:var(--muted); line-height:1.4; margin-top:6px;}
  .exCard .center{flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14px; margin:14px 0;}
  .bigweight{font-size:54px; font-weight:850; letter-spacing:-1px; cursor:pointer; text-align:center; line-height:1;}
  .bigweight small{display:block; font-size:13px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:var(--muted); margin-bottom:8px;}
  .bigweight.empty{font-size:22px; color:var(--muted); font-style:italic;}
  .bigchip{font-size:13px; font-weight:800; letter-spacing:.5px; padding:7px 16px; border-radius:999px; text-transform:uppercase;}
  .bigchip.stay{background:rgba(96,165,250,.16); color:var(--stay); border:1px solid rgba(96,165,250,.4);}
  .bigchip.up{background:rgba(52,211,153,.16); color:var(--up); border:1px solid rgba(52,211,153,.45);}
  .bigchip.none{background:var(--card2); color:var(--muted); border:1px solid var(--line);}
  .swipehint{text-align:center; color:var(--muted); font-size:13px; font-weight:600; margin-top:4px; opacity:.8;}
  .sess-bottom{padding:12px 16px calc(env(safe-area-inset-bottom) + 16px); display:flex; flex-direction:column; gap:10px;}
  .doneBig{width:100%; padding:18px; border-radius:16px; border:none; cursor:pointer; background:linear-gradient(135deg,var(--done),#15a34a); color:#04210f; font-size:18px; font-weight:850;}
  .skipBig{width:100%; padding:11px; border-radius:12px; border:1px solid var(--line); background:transparent; color:var(--muted); font-size:14px; font-weight:600; cursor:pointer;}
  .sheet{position:fixed; inset:0; z-index:70; display:flex; align-items:flex-end; justify-content:center; background:rgba(0,0,0,.55); opacity:0; pointer-events:none; transition:opacity .25s;}
  .sheet.open{opacity:1; pointer-events:auto;}
  .sheet .panel{width:100%; max-width:560px; background:#121826; border:1px solid var(--line); border-bottom:none; border-radius:24px 24px 0 0; padding:22px 18px calc(env(safe-area-inset-bottom) + 22px); transform:translateY(100%); transition:transform .3s cubic-bezier(.2,.8,.2,1);}
  .sheet.open .panel{transform:none;}
  .sheet h3{margin:2px 0 4px; font-size:21px; font-weight:800; text-align:center;}
  .sheet .sub{text-align:center; color:var(--muted); font-size:14px; margin-bottom:18px;}
  .sheet .sub b{color:var(--text);}
  .opt{width:100%; display:flex; align-items:center; gap:14px; padding:16px; border-radius:16px; margin-bottom:10px; cursor:pointer; border:1.5px solid var(--line); background:var(--card2); color:var(--text); text-align:left;}
  .opt .ic{font-size:26px; width:34px; text-align:center;}
  .opt .tx{flex:1;}
  .opt .tt{font-size:17px; font-weight:800;}
  .opt .ds{font-size:13px; color:var(--muted); margin-top:1px;}
  .opt .pv{font-size:17px; font-weight:850;}
  .opt.up{border-color:rgba(52,211,153,.5);} .opt.up .ic,.opt.up .pv{color:var(--up);}
  .opt.keep{border-color:rgba(96,165,250,.5);} .opt.keep .ic,.opt.keep .pv{color:var(--stay);}
  .opt.down{border-color:rgba(245,158,11,.5);} .opt.down .ic,.opt.down .pv{color:var(--down);}
  .report{width:100%; max-width:560px; max-height:100%; overflow-y:auto; padding:6px 2px;}
  .report .big{font-size:30px; font-weight:850; text-align:center;}
  .report .date{text-align:center; color:var(--muted); font-size:14px; margin:4px 0 18px;}
  .statgrid{display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:18px;}
  .stat{background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px 8px; text-align:center;}
  .stat .n{font-size:26px; font-weight:850;}
  .stat .l{font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; margin-top:2px;}
  .stat.green .n{color:var(--up);} .stat.amber .n{color:var(--down);}
  .sec{margin-bottom:16px;}
  .sec h4{font-size:13px; text-transform:uppercase; letter-spacing:.6px; color:var(--muted); margin:0 2px 8px;}
  .rrow{display:flex; align-items:center; justify-content:space-between; gap:10px; background:var(--card); border:1px solid var(--line); border-radius:12px; padding:11px 13px; margin-bottom:7px;}
  .rrow .rn{font-size:15px; font-weight:650;}
  .rrow .rv{font-size:14px; font-weight:800; white-space:nowrap;}
  .rrow.up{border-color:rgba(52,211,153,.4);} .rrow.up .rv{color:var(--up);}
  .rrow.down{border-color:rgba(245,158,11,.4);} .rrow.down .rv{color:var(--down);}
  .rrow .rv .arrow{color:var(--muted); font-weight:600; margin:0 4px;}
  .finishBig{width:100%; padding:17px; border-radius:16px; border:none; cursor:pointer; background:linear-gradient(135deg,var(--accent),#7c5cff); color:#fff; font-size:17px; font-weight:850; margin-top:6px;}
  .toast{position:fixed; left:50%; bottom:calc(env(safe-area-inset-bottom) + 86px); transform:translateX(-50%); background:#0f1622; border:1px solid var(--line); color:var(--text); padding:10px 16px; border-radius:12px; font-size:14px; font-weight:600; z-index:90; opacity:0; pointer-events:none; transition:opacity .2s, transform .2s; box-shadow:0 10px 30px rgba(0,0,0,.5);}
  .toast.show{opacity:1; transform:translateX(-50%) translateY(-4px);}
  .hidden{display:none !important;}
</style>
</head>
<body>
<header>
  <div class="titlebar">
    <h1>🏋️ My Lifts <small id="todayLbl"></small></h1>
    <button class="iconbtn" id="editToggle" title="Edit">✎</button>
  </div>
  <div class="tabs" id="tabs"></div>
</header>

<!-- ===== WORKOUT VIEW ===== -->
<main id="workoutMain">
  <button class="startbtn" id="startBtn">▶ Start Workout<span class="s" id="startSub"></span></button>
  <div class="daymeta">
    <div class="prog" id="dayProg"></div>
    <button class="smallbtn" id="resetBtn">↺ Reset checks</button>
  </div>
  <div class="progbar"><i id="progFill"></i></div>
  <div id="list"></div>
  <div id="addRow" style="display:none"><button class="addbtn" id="addBtn">+ Add exercise</button></div>
  <div class="hint" id="hint"></div>
</main>

