/* muscle element ids + display names */
const MUSCLE_EL={
  neck:["m-neck"], frontDelt:["m-fdelt-l","m-fdelt-r"], sideDelt:["m-sdelt-l","m-sdelt-r"],
  rearDelt:["m-rdelt-l","m-rdelt-r"], chest:["m-chest-l","m-chest-r"], biceps:["m-bi-l","m-bi-r"],
  triceps:["m-tri-l","m-tri-r"], forearms:["m-fore-l","m-fore-r"], abs:["m-abs"],
  obliques:["m-obl-l","m-obl-r"], traps:["m-traps"], lats:["m-lat-l","m-lat-r"],
  upperBack:["m-uback-l","m-uback-r"], lowerBack:["m-lback"], glutes:["m-glute-l","m-glute-r"],
  quads:["m-quad-l","m-quad-r"], hamstrings:["m-ham-l","m-ham-r"], calves:["m-calf-l","m-calf-r"]
};
const MNAME={neck:"Neck",frontDelt:"Front Delts",sideDelt:"Side Delts",rearDelt:"Rear Delts",chest:"Chest",biceps:"Biceps",triceps:"Triceps",forearms:"Forearms",abs:"Abs",obliques:"Obliques",traps:"Traps",lats:"Lats",upperBack:"Upper Back",lowerBack:"Lower Back",glutes:"Glutes",quads:"Quads",hamstrings:"Hamstrings",calves:"Calves"};

function inferMuscles(name){
  const n=name.toLowerCase(); const s=new Set(); const add=(...m)=>m.forEach(x=>s.add(x));
  if(n.includes("neck")||n.includes("chin tuck")){ add("neck"); return s; }
  if(n.includes("hip stretch")||n.includes("band stretch")||n.includes("warm up")||n.includes("plyometric")) return s;
  if(n.includes("treadmill")||n.includes("walk")){ add("calves","glutes","quads"); return s; }
  if(n.includes("calf")) add("calves");
  if(n.includes("hamstring")||n.includes("rdl")||n.includes("romanian")) add("hamstrings","glutes");
  if(n.includes("leg extension")) add("quads");
  if(n.includes("leg press")||n.includes("squat")) add("quads","glutes");
  if(n.includes("side crunch")||n.includes("oblique")) add("obliques");
  else if(n.includes("crunch")||n.includes("ab machine")||n.includes("ab crunch")) add("abs");
  if(n.includes("lower back")||n.includes("back extension")) add("lowerBack");
  if(n.includes("shrug")) add("traps");
  if(n.includes("scapula")) add("upperBack","traps");
  if(n.includes("lateral raise")) add("sideDelt");
  if(n.includes("front delt")||n.includes("front raise")) add("frontDelt");
  if(n.includes("rear delt")) add("rearDelt");
  if(n.includes("shoulder press")) add("frontDelt","sideDelt","triceps");
  if(n.includes("forearm")) add("forearms");
  else if(n.includes("hammer")||n.includes("reverse curl")) add("biceps","forearms");
  else if(n.includes("curl")&&!n.includes("hamstring")&&!n.includes("leg")) add("biceps");
  if(n.includes("tricep")||n.includes("push down")||n.includes("pushdown")) add("triceps");
  if(n.includes("pull up")||n.includes("pullup")||n.includes("lat pull")||n.includes("pulldown")||n.includes("pull down")) add("lats","biceps");
  if(n.includes("row")) add("upperBack","lats","rearDelt");
  if(n.includes("dip")) add("chest","triceps","frontDelt");
  if(n.includes("fly")||n.includes("flies")) add("chest");
  if(n.includes("bench")||n.includes("chest press")) add("chest","triceps","frontDelt");
  return s;
}

/* ---------- State ---------- */
const KEY="myLifts.v2";
let state, editMode=false, weightEditing=null, view="workout";
function load(){ try{ const s=JSON.parse(localStorage.getItem(KEY)); if(s&&s.days) return s; }catch(e){} return { activeDay:0, days:PROGRAM.map(d=>({name:d.name,lastDone:null,exercises:d.exercises.map(e=>({...e}))})), session:null }; }
function save(){ localStorage.setItem(KEY, JSON.stringify(state)); }

/* ---------- Helpers ---------- */
function fmtNum(n){ return (Math.round(n*10)/10).toString(); }
function bump(w,dir){ const m=w.match(/(\d+(\.\d+)?)/); if(!m) return w; let n=parseFloat(m[1]); const step=(n%1!==0)?2.5:5; n=dir==="up"?n+step:Math.max(0,n-step); return w.replace(m[1],fmtNum(n)); }
function hasW(e){ return e.weight.trim()!==""; }
function relDate(iso){ if(!iso) return "never"; const d=new Date(iso),now=new Date(); const days=Math.floor((new Date(now.toDateString())-new Date(d.toDateString()))/864e5); if(days===0)return"today"; if(days===1)return"yesterday"; if(days<7)return days+" days ago"; return d.toLocaleDateString(undefined,{month:"short",day:"numeric"}); }
function escHtml(s){ return String(s).replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c])); }
function escAttr(s){ return String(s).replace(/"/g,"&quot;").replace(/</g,"&lt;"); }
let toastT; function toast(m){ const t=document.getElementById("toast"); t.textContent=m; t.classList.add("show"); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove("show"),1500); }

/* ---------- View switching ---------- */
function setView(v){
  view=v;
  document.getElementById("workoutMain").classList.toggle("hidden", v!=="workout");
  document.getElementById("muscleMain").classList.toggle("hidden", v!=="muscles");
  document.getElementById("editToggle").style.visibility = v==="workout"?"visible":"hidden";
  document.getElementById("navWorkout").classList.toggle("active", v==="workout");
  document.getElementById("navMuscles").classList.toggle("active", v==="muscles");
  if(v==="muscles") renderMuscle();
}
document.getElementById("navWorkout").addEventListener("click",()=>setView("workout"));
document.getElementById("navMuscles").addEventListener("click",()=>setView("muscles"));

/* ---------- Main list ---------- */
function render(){
  const day=state.days[state.activeDay];
  document.getElementById("todayLbl").textContent="· "+new Date().toLocaleDateString(undefined,{weekday:"short",month:"short",day:"numeric"});
  document.getElementById("tabs").innerHTML=state.days.map((d,i)=>{ const all=d.exercises.length&&d.exercises.every(e=>e.done); return `<button class="tab ${i===state.activeDay?'active':''}" data-tab="${i}">${d.name}${all?'<span class="dot"></span>':''}</button>`; }).join("");
  const total=day.exercises.length, done=day.exercises.filter(e=>e.done).length;
  document.getElementById("startSub").textContent=day.name+" · "+total+" exercises";
  document.getElementById("dayProg").innerHTML=`<b>${done}/${total}</b> done · last: ${relDate(day.lastDone)}`;
  document.getElementById("progFill").style.width=total?(done/total*100)+"%":"0%";
  const list=document.getElementById("list");
  list.className=editMode?"editmode":"";
  list.innerHTML=day.exercises.map((e,i)=>card(e,i)).join("");
  document.getElementById("addRow").style.display=editMode?"block":"none";
  document.getElementById("editToggle").classList.toggle("active",editMode);
  document.getElementById("hint").textContent=editMode?"Edit mode: rename, delete, tap a tag to cycle stay/up/none, or add exercises.":"Tap “Start Workout” for guided mode — or check items off here manually.";
  if(weightEditing){ const inp=list.querySelector('.wedit'); if(inp){inp.focus();inp.select();} }
  if(view==="muscles") renderMuscle();
}
function card(e,i){
  const editingW=weightEditing&&weightEditing.i===i;
  const tagCls=e.tag==="up"?"up":e.tag==="stay"?"stay":"none";
  const tagTxt=e.tag==="up"?"↑ up":e.tag==="stay"?"= stay":"— set";
  const nameHtml=editMode?`<input class="nameinput" data-act="rename" data-i="${i}" value="${escAttr(e.name)}">`:`<div class="name">${escHtml(e.name)}</div>`;
  let weightHtml;
  if(editingW) weightHtml=`<input class="wedit" data-act="wcommit" data-i="${i}" value="${escAttr(e.weight)}" placeholder="e.g. 65lbs" enterkeyhint="done">`;
  else if(hasW(e)) weightHtml=`<span class="weight" data-act="wedit" data-i="${i}">${escHtml(e.weight)}</span>`;
  else weightHtml=`<span class="weight empty" data-act="wedit" data-i="${i}">+ weight</span>`;
  const chipHtml=`<span class="chip ${tagCls}" ${editMode?`data-act="cycletag" data-i="${i}"`:''}>${tagTxt}</span>`;
  return `<div class="card ${e.done?'done':''}"><div class="row"><div class="check" data-act="toggle" data-i="${i}">✓</div><div class="info">${nameHtml}${e.note?`<div class="note">${escHtml(e.note)}</div>`:""}<div class="meta">${weightHtml}${chipHtml}</div></div>${editMode?`<div class="delx" data-act="del" data-i="${i}">✕</div>`:""}</div></div>`;
}
document.getElementById("tabs").addEventListener("click",e=>{const b=e.target.closest("[data-tab]");if(!b)return;state.activeDay=+b.dataset.tab;weightEditing=null;save();render();});
document.getElementById("editToggle").addEventListener("click",()=>{editMode=!editMode;weightEditing=null;render();});
document.getElementById("resetBtn").addEventListener("click",()=>{const day=state.days[state.activeDay];day.exercises.forEach(e=>{e.done=false;e.change=null;});save();render();toast("Checks cleared");});
document.getElementById("addBtn").addEventListener("click",()=>{const n=prompt("New exercise name:");if(!n)return;const w=prompt("Starting weight (blank if none):","")||"";state.days[state.activeDay].exercises.push(ex(n.trim(),w.trim(),""));save();render();});
document.getElementById("list").addEventListener("click",e=>{
  const t=e.target.closest("[data-act]");if(!t)return;const act=t.dataset.act,i=+t.dataset.i;const day=state.days[state.activeDay],item=day.exercises[i];
  if(act==="toggle"){item.done=!item.done;if(!item.done)item.change=null;save();render();}
  else if(act==="wedit"){weightEditing={i};render();}
  else if(act==="cycletag"){item.tag=item.tag===""?"stay":item.tag==="stay"?"up":"";save();render();}
  else if(act==="del"){if(confirm("Delete \""+item.name+"\"?")){day.exercises.splice(i,1);save();render();}}
});
document.getElementById("list").addEventListener("keydown",e=>{if(e.target.classList.contains("wedit")&&e.key==="Enter")e.target.blur();});
document.getElementById("list").addEventListener("blur",e=>{const t=e.target;if(!t.dataset)return;if(t.dataset.act==="wcommit"){state.days[state.activeDay].exercises[+t.dataset.i].weight=t.value.trim();weightEditing=null;save();render();}else if(t.dataset.act==="rename"){const v=t.value.trim();if(v)state.days[state.activeDay].exercises[+t.dataset.i].name=v;save();}},true);

/* ---------- Muscle view ---------- */
function renderMuscle(){
  const day=state.days[state.activeDay];
  const counts={};
  day.exercises.forEach(e=>{ inferMuscles(e.name).forEach(m=>counts[m]=(counts[m]||0)+1); });
  document.querySelectorAll("#muscleMain .mz").forEach(el=>{ el.style.fill=""; });
  const colorFor=c=>c>=3?"#ef4444":c===2?"#fb7a3c":"#f4b740";
  Object.keys(counts).forEach(m=>{ const col=colorFor(counts[m]); (MUSCLE_EL[m]||[]).forEach(id=>{const el=document.getElementById(id); if(el) el.style.fill=col;}); });
  document.getElementById("muscleDayLbl").textContent=day.name;
  const order=Object.keys(counts).sort((a,b)=>counts[b]-counts[a]);
  document.getElementById("muscleSummary").textContent=order.length?(order.length+" muscle groups targeted this day"):"";
  document.getElementById("muscleList").innerHTML=order.length
    ? order.map(m=>`<div class="mrow"><span class="mdot" style="background:${colorFor(counts[m])}"></span><span class="mname">${MNAME[m]}</span><span class="mcount">${counts[m]}× exercise${counts[m]===1?"":"s"}</span></div>`).join("")
    : `<div class="mrow"><span class="mname" style="color:var(--muted)">No lifting muscles tagged for this day.</span></div>`;
}

/* ====================================================================
   SESSION MODE
==================================================================== */
const sessEl=document.getElementById("session");
const stageEl=document.getElementById("stage");
const sheetEl=document.getElementById("sheet");
document.getElementById("startBtn").addEventListener("click",()=>{ if(state.session&&state.session.active&&!confirm("A workout is already in progress. Start over?")){ openSession(); renderSession(); return; } startSession(state.activeDay); });
document.getElementById("sessClose").addEventListener("click",()=>{ if(state.session&&state.session.phase!=="report"){ if(!confirm("End this workout? Your weight changes so far are saved.")) return; } state.session.active=false; save(); closeSession(); });
function startSession(dayIdx){ const day=state.days[dayIdx]; state.session={active:true,day:dayIdx,startTime:new Date().toISOString(),pos:0,phase:"exercise",results:day.exercises.map(()=>({done:false,skipped:false,change:null,from:null,to:null}))}; day.exercises.forEach(e=>{e.done=false;e.change=null;}); save(); openSession(); renderSession(); }
function openSession(){ document.body.style.overflow="hidden"; sessEl.classList.add("open"); }
function closeSession(){ document.body.style.overflow=""; sessEl.classList.remove("open"); sheetEl.classList.remove("open"); render(); }
function renderSession(){
  const s=state.session; if(!s) return; const day=state.days[s.day]; const N=day.exercises.length;
  if(s.pos>=N) s.phase="report";
  document.getElementById("sessFill").style.width=Math.min(100,(s.pos/N*100))+"%";
  document.getElementById("sessCount").textContent=s.phase==="report"?"Done":((Math.min(s.pos+1,N))+" / "+N);
  if(s.phase==="report"){ renderReport(); document.getElementById("sessBottom").innerHTML=""; sheetEl.classList.remove("open"); return; }
  const e=day.exercises[s.pos];
  const tagCls=e.tag==="up"?"up":e.tag==="stay"?"stay":"none";
  const tagTxt=e.tag==="up"?"↑ go up":e.tag==="stay"?"= stay same":"— your call";
  const weightHtml=hasW(e)?`<div class="bigweight" id="bw"><small>Working weight</small>${escHtml(e.weight)}</div>`:`<div class="bigweight empty" id="bw">tap to add weight</div>`;
  stageEl.innerHTML=`<div class="exCard" id="exCard"><div class="kicker">Exercise ${s.pos+1} of ${N}</div><div class="exname">${escHtml(e.name)}</div>${e.note?`<div class="exnote">${escHtml(e.note)}</div>`:""}<div class="center">${weightHtml}<span class="bigchip ${tagCls}">${tagTxt}</span></div><div class="swipehint">← swipe to continue →</div></div>`;
  document.getElementById("sessBottom").innerHTML=`<button class="doneBig" id="doneBtn">${hasW(e)?'✓ Done — set next weight':'✓ Done — next'}</button><button class="skipBig" id="skipBtn">Skip this exercise</button>`;
  document.getElementById("doneBtn").addEventListener("click",completeCurrent);
  document.getElementById("skipBtn").addEventListener("click",()=>{s.results[s.pos].skipped=true;advance();});
  document.getElementById("bw").addEventListener("click",()=>{const v=prompt("Weight for "+e.name+":",e.weight);if(v!==null){e.weight=v.trim();save();renderSession();}});
  bindSwipe(document.getElementById("exCard"));
}
function completeCurrent(){ const s=state.session,day=state.days[s.day],e=day.exercises[s.pos]; s.results[s.pos].done=true; e.done=true; if(hasW(e)) openAdjust(); else advance(); }
function bindSwipe(card){
  let x0=0,y0=0,dx=0,dy=0,drag=false,horiz=false;
  card.addEventListener("pointerdown",ev=>{drag=true;horiz=false;x0=ev.clientX;y0=ev.clientY;dx=dy=0;try{card.setPointerCapture(ev.pointerId);}catch(e){}card.style.transition="none";});
  card.addEventListener("pointermove",ev=>{ if(!drag)return; dx=ev.clientX-x0; dy=ev.clientY-y0; if(!horiz&&Math.abs(dx)>10&&Math.abs(dx)>Math.abs(dy)) horiz=true; if(horiz){ ev.preventDefault(); card.style.transform=`translateX(${dx}px) rotate(${dx*0.03}deg)`; card.style.opacity=Math.max(.3,1-Math.abs(dx)/400); } });
  card.addEventListener("pointerup",()=>{ if(!drag)return; drag=false; card.style.transition="transform .25s, opacity .25s"; if(horiz&&Math.abs(dx)>100){ const dir=dx>0?1:-1; card.style.transform=`translateX(${dir*window.innerWidth}px) rotate(${dir*8}deg)`; card.style.opacity="0"; setTimeout(completeCurrent,180); } else { card.style.transform=""; card.style.opacity="1"; } });
  card.addEventListener("pointercancel",()=>{drag=false;card.style.transition="transform .2s";card.style.transform="";card.style.opacity="1";});
}
function openAdjust(){
  const s=state.session,e=state.days[s.day].exercises[s.pos]; const up=bump(e.weight,"up"),dn=bump(e.weight,"down");
  document.getElementById("sheetPanel").innerHTML=`<h3>How did that feel?</h3><div class="sub">Set <b>${escHtml(e.name)}</b> weight for next time</div>
    <button class="opt up" data-ch="up"><span class="ic">⬆</span><span class="tx"><span class="tt">Up the weight</span><span class="ds">Too easy — progress</span></span><span class="pv">${escHtml(up)}</span></button>
    <button class="opt keep" data-ch="keep"><span class="ic">➡</span><span class="tx"><span class="tt">Keep the same</span><span class="ds">Stay here next time</span></span><span class="pv">${escHtml(e.weight)}</span></button>
    <button class="opt down" data-ch="down"><span class="ic">⬇</span><span class="tx"><span class="tt">Decrease</span><span class="ds">Back off a little</span></span><span class="pv">${escHtml(dn)}</span></button>`;
  sheetEl.classList.add("open");
  sheetEl.querySelectorAll(".opt").forEach(b=>b.addEventListener("click",()=>chooseAdjust(b.dataset.ch)));
}
function chooseAdjust(ch){ const s=state.session,e=state.days[s.day].exercises[s.pos],r=s.results[s.pos]; r.from=e.weight; if(ch==="up") e.weight=bump(e.weight,"up"); else if(ch==="down") e.weight=bump(e.weight,"down"); r.to=e.weight; r.change=ch; e.change=ch; sheetEl.classList.remove("open"); save(); setTimeout(advance,180); }
function advance(){ const s=state.session; s.pos++; s.phase="exercise"; save(); renderSession(); }
function renderReport(){
  const s=state.session,day=state.days[s.day],exs=day.exercises;
  const ups=[],downs=[],keeps=[],skipped=[]; let completed=0;
  exs.forEach((e,i)=>{ const r=s.results[i]; if(r.skipped){skipped.push(e);return;} if(r.done){completed++; if(r.change==="up")ups.push({e,r}); else if(r.change==="down")downs.push({e,r}); else keeps.push({e,r}); } });
  const mins=Math.max(1,Math.round((Date.now()-new Date(s.startTime))/60000));
  const dur=mins>=60?Math.floor(mins/60)+"h "+(mins%60)+"m":mins+" min";
  const rowsUp=ups.map(({e,r})=>`<div class="rrow up"><span class="rn">${escHtml(e.name)}</span><span class="rv">${escHtml(r.from)}<span class="arrow">→</span>${escHtml(r.to)} ⬆</span></div>`).join("");
  const rowsDown=downs.map(({e,r})=>`<div class="rrow down"><span class="rn">${escHtml(e.name)}</span><span class="rv">${escHtml(r.from)}<span class="arrow">→</span>${escHtml(r.to)} ⬇</span></div>`).join("");
  const skipNames=skipped.map(e=>escHtml(e.name)).join(", ");
  stageEl.innerHTML=`<div class="report"><div class="big">💪 Workout Complete!</div>
    <div class="date">${day.name} · ${new Date().toLocaleDateString(undefined,{weekday:"long",month:"short",day:"numeric"})} · ${dur}</div>
    <div class="statgrid"><div class="stat"><div class="n">${completed}/${exs.length}</div><div class="l">Completed</div></div><div class="stat green"><div class="n">${ups.length}</div><div class="l">Progressed</div></div><div class="stat amber"><div class="n">${downs.length}</div><div class="l">Backed off</div></div></div>
    ${ups.length?`<div class="sec"><h4>📈 You progressed in</h4>${rowsUp}</div>`:`<div class="sec"><h4>📈 Progress</h4><div class="rrow"><span class="rn" style="color:var(--muted)">No increases this session — consistency still wins.</span></div></div>`}
    ${downs.length?`<div class="sec"><h4>📉 Eased off</h4>${rowsDown}</div>`:""}
    <div class="sec"><h4>✅ Maintained / done</h4><div class="rrow"><span class="rn">${keeps.length} exercise${keeps.length===1?"":"s"} kept at current weight or bodyweight</span></div></div>
    ${skipped.length?`<div class="sec"><h4>⏭ Skipped</h4><div class="rrow"><span class="rn" style="color:var(--muted)">${skipNames}</span></div></div>`:""}
    <button class="finishBig" id="finishBtn">Finish &amp; Save</button></div>`;
  document.getElementById("finishBtn").addEventListener("click",finishSession);
}
function finishSession(){ const s=state.session,day=state.days[s.day]; day.lastDone=new Date().toISOString(); day.exercises.forEach(e=>{e.done=false;e.change=null;}); s.active=false; state.session=null; save(); toast("Session saved 💾"); closeSession(); }

/* ---------- Boot ---------- */
state=load();
render();
if(state.session&&state.session.active){ openSession(); renderSession(); }
</script>
</body>
</html>
